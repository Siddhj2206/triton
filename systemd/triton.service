[Unit]
Description=Triton Desktop Shell for niri
Documentation=https://github.com/Siddhj2206/triton
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/triton --real-services
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
